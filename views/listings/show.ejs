<% layout("layouts/boilerplate") %>
<body>
<div class="row">
    <div class="col-8 offset-3">
    <h2><b><%= listing.title %></b></h2>
    </div>
    <div class="card col-6 offset-3 show-card">
        <img src="<%= listing.image %>" class="card-img-top show-img" alt="listing image">
        <div class="card-body">
            <p class="card-text">
                <%= listing.description %> <br>
                &#8377;<%= listing.price.toLocaleString("en-IN")%> <br>
                <%= listing.location %> <br>
                <%= listing.country %>
            </p>
        </div> 
    </div>
</div>
<div class="btns">
    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn col-1 offset-3">Edit</a>
    <br>
    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-dark offset-6" >Delete</button>
    </form>
    </div>
    <a href="/listings" class="btn btn-dark back-btn offset-3 mt-3 mb-3">Back to Listings</a>
    <div class="col-8 offset-3 mt-3 mb-3">
    <hr>
    <form action="/listings/<%= listing.id %>/reviews" method="post" class="needs-validation" novalidate>
        <h4>Leave a Review</h4>
        <div class="mt-3 mb-3">
            <label for="Rating" class="form-label">Rating</label>
            <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
        </div>
        <div class="mt-3 mb-3">
            <label for="comment" class="form-label">Comment</label>
            <textarea id="comment" cols="30" rows="5" name="review[comment]" class="form-control"
            required></textarea>
            <div class="invalid-feedback">
            Please add some comments.
            </div>
        </div>
        <button class="btn btn-outline-dark">Submit</button>
    </form>
    <hr>
    <b><p> Reviews </p></b>
    <div class="row">
        <% for(review of listing.reviews){%>
        <div class="card-reviews col-5 mt-2 ms-2">
            <div class="card-body">
                <h5 class="card-title">Name </h5>
                <p class="card-text"><%= review.comment %></p>
                <p class="card-text"><%= review.rating %> Stars</p>
            </div>
            <form  method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mb-3">
                <button class="btn btn-dark btn-sm">DELETE</button>
            </form> 
        </div>
        <% } %>
    </div>
    </div>
</body>